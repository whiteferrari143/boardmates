{
  // Production config for Cloudflare Workers. See DEPLOY-CLOUDFLARE.md.
  // The local dev flow (pnpm dev / pnpm db:local) does not use this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boardmates",
  "main": "./build/sites-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boardmates",
      // ID of the production D1 database (not a secret).
      "database_id": "1d5f8410-e330-4f58-8a15-a04a955496b1",
      "migrations_dir": "drizzle"
    }
  ]
}
